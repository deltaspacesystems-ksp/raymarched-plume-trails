// "Wmalowuje" aktualne kłęby (suma miękkich kul, ta sama formuła co wcześniej
// liczona per-pixel w fragment shaderze) w małą teksturę 3D, RAZ na klatkę,
// zamiast liczyć sumę po wszystkich kłębach w KAŻDYM punkcie próbki podczas
// marchingu (koszt O(N) razy liczba kroków razy liczba pikseli). Fragment
// shader potem tylko próbkuje tę teksturę (tani, trilinear-filtrowany lookup,
// O(1) na krok) - to jest fix na lag przy kamerze wewnątrz chmury i na
// nieciągłości między kulami (filtering wygładza za darmo).
#pragma kernel Splat
#pragma kernel Blur

#define MAX_PUFFS 256

RWTexture3D<float> _DensityTex;
RWTexture3D<float> _BlurredTex; // cel drugiego passa (Blur) - ping-pong bufor

int _PuffCount;
float4 _PuffCenters[MAX_PUFFS]; // world space, .w nieużywane
float _PuffRadii[MAX_PUFFS];
float _BlendRadiusMultiplier;

float3 _BoxMin;
float3 _BoxSize;
uint3 _Resolution;

[numthreads(4,4,4)]
void Splat(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution.x || id.y >= _Resolution.y || id.z >= _Resolution.z) return;

    float3 uv = (float3(id) + 0.5) / float3(_Resolution);
    float3 worldPos = _BoxMin + uv * _BoxSize;

    float density = 0.0;
    for (int i = 0; i < _PuffCount; i++)
    {
        float3 center = _PuffCenters[i].xyz;
        float radius = _PuffRadii[i];
        if (radius <= 0.0) continue;

        float blendRadius = radius * _BlendRadiusMultiplier;
        float d = distance(worldPos, center);
        if (d >= blendRadius) continue;

        float t = saturate(1.0 - d / blendRadius);
        density += t * t * (3.0 - 2.0 * t); // smoothstep, sumowany wkład (union)
    }

    _DensityTex[id] = saturate(density);
}

// Prosty box blur 3x3x3 na już wmalowanej gęstości - to jest to, co realnie zbliża
// wygląd do EVE: EVE nie ma "kul" ani "krzywych", ma miękko POMALOWANĄ mapę pokrycia
// (+ szum). Ostre, geometryczne krawędzie kul po zsumowaniu nadal są "kulopodobne" w
// miejscach gdzie tylko 1-2 kule się nakładają - blur zaciera tę geometryczność,
// dając bardziej "namalowany", ciągły wygląd niezależnie od tego ile kul akurat tu
// wpływa. Tanie - tekstura ma tylko dziesiątki tysięcy teksli, 27 próbek na teksel.
[numthreads(4,4,4)]
void Blur(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution.x || id.y >= _Resolution.y || id.z >= _Resolution.z) return;

    float sum = 0.0;
    int count = 0;

    for (int dz = -1; dz <= 1; dz++)
    for (int dy = -1; dy <= 1; dy++)
    for (int dx = -1; dx <= 1; dx++)
    {
        int3 p = int3(id) + int3(dx, dy, dz);
        if (p.x < 0 || p.y < 0 || p.z < 0) continue;
        if (p.x >= (int)_Resolution.x || p.y >= (int)_Resolution.y || p.z >= (int)_Resolution.z) continue;

        sum += _DensityTex[uint3(p)];
        count++;
    }

    _BlurredTex[id] = sum / max(count, 1);
}
